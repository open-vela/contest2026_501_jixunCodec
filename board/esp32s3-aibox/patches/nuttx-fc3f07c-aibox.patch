+/****************************************************************************
+ * Name: esp32s3_i2s_rx_abort
+ *
+ * Description:
+ *   Abort every in-flight and pending RX transfer on the given port and
+ *   restart the RX channel from a clean state.
+ *
+ *   背景（2026-10-13）：ES7210 作 I2C slave 偶发锁不住 MCLK/LRCK 时，RX
+ *   DMA 收不满一个 apb -> EOF 中断永不到达 -> 驱动 rx.act 里那个
+ *   container 永远挂着，后续 i2s_receive 排进 rx.pend 也永远不启动。
+ *   HAL 层预读链的在途计数因此停在深度值不归零，hal_i2s_read_slot 每次
+ *   都是 3 秒超时，重试多少次都一样（现场表现：提示音响完没反应）。
+ *   本函数把 rx.act / rx.pend 里的 container 全部以 -ECANCELED 交给正常
+ *   完成路径（worker -> 回调 -> 上层回收 apb 并把在途计数归零），再
+ *   stop/start 一次 RX 通道，让硬件回到干净状态。
+ *
+ * Input Parameters:
+ *   port - I2S port number (0/1)
+ *
+ * Returned Value:
+ *   None
+ *
+ ****************************************************************************/
+
+#ifdef I2S_HAVE_RX
+void esp32s3_i2s_rx_abort(int port)
+{
+  FAR struct esp32s3_i2s_s *priv;
+  struct esp32s3_buffer_s *bfcontainer;
+  irqstate_t flags;
+  int ret;
+
+  switch (port)
+    {
+#ifdef CONFIG_ESP32S3_I2S0
+      case ESP32S3_I2S0:
+        priv = &esp32s3_i2s0_priv;
+        break;
+#endif
+#ifdef CONFIG_ESP32S3_I2S1
+      case ESP32S3_I2S1:
+        priv = &esp32s3_i2s1_priv;
+        break;
+#endif
+      default:
+        return;
+    }
+
+  /* 1) 在途 / 待发 container 全部标记取消并搬进 done 队列 */
+
+  /* 2026-10-13 SMP race fix: the RX ISR / rx worker may touch
+   * rx.act / rx.pend on the other core. enter_critical_section()
+   * only masks local IRQs, so it cannot protect the queues on SMP.
+   * Use the driver spinlock and keep stop/start inside it. */
+  flags = spin_lock_irqsave(&priv->slock);
+
+  while (!sq_empty(&priv->rx.act))
+    {
+      bfcontainer = (struct esp32s3_buffer_s *)sq_remfirst(&priv->rx.act);
+      bfcontainer->result = -ECANCELED;
+      sq_addlast((sq_entry_t *)bfcontainer, &priv->rx.done);
+    }
+
+  while (!sq_empty(&priv->rx.pend))
+    {
+      bfcontainer = (struct esp32s3_buffer_s *)sq_remfirst(&priv->rx.pend);
+      bfcontainer->result = -ECANCELED;
+      sq_addlast((sq_entry_t *)bfcontainer, &priv->rx.done);
+    }
+
+  /* 2) 停 RX 通道（清 RX_START、停 DMA、关中断）再重启（DMA/RX 复位） */
+
+  i2s_rx_channel_stop(priv);
+  i2s_rx_channel_start(priv);
+
+  spin_unlock_irqrestore(&priv->slock, flags);
+
+  /* 3) 交给 RX worker 回收，回调以 result=-ECANCELED 通知上层 */
+
+  if (!sq_empty(&priv->rx.done) && work_available(&priv->rx.work))
+    {
+      ret = work_queue(HPWORK, &priv->rx.work, i2s_rx_worker, priv, 0);
+      if (ret != 0)
+        {
+          i2serr("ERROR: Failed to queue RX work: %d\n", ret);
+        }
+    }
+}
+#endif /* I2S_HAVE_RX */
+
 #endif /* CONFIG_ESP32S3_I2S */
