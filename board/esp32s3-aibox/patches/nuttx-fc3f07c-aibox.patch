--- a/arch/xtensa/src/esp32s3/esp32s3_allocateheap.c
+++ b/arch/xtensa/src/esp32s3/esp32s3_allocateheap.c
@@ -73,6 +73,19 @@
 
 #define ESP32S3_HEAP_TOP     0x3fced710
 
+/* JX: internal DRAM reserved at the top of the common heap for the Wi-Fi
+ * driver.  esp_wifi RX/TX buffers must live in internal RAM; without this
+ * carve-out the common heap hands those last bytes to ordinary malloc calls
+ * and esp_wifi ends up with ENOMEM.
+ */
+
+#ifndef JX_WIFI_IRAM_RESERVE
+#  define JX_WIFI_IRAM_RESERVE (48 * 1024)
+#endif
+
+uintptr_t g_jx_wifi_iram_base;
+size_t    g_jx_wifi_iram_size = JX_WIFI_IRAM_RESERVE;
+
 #ifdef CONFIG_MM_KERNEL_HEAP
 #  if defined(CONFIG_ESP32S3_SPIRAM)
 #    define MM_USER_HEAP_EXTRAM
@@ -139,7 +152,8 @@ void up_allocate_heap(void **heap_start, size_t *heap_size)
    */
 
   ubase = (uintptr_t)(_sheap) + XTENSA_IMEM_REGION_SIZE;
-  utop  = ESP32S3_HEAP_TOP;
+  utop  = ESP32S3_HEAP_TOP - JX_WIFI_IRAM_RESERVE;
+  g_jx_wifi_iram_base = utop;
 #endif /* CONFIG_MM_KERNEL_HEAP */
 
   usize = utop - ubase;
@@ -243,8 +257,12 @@ void xtensa_add_region(void)
 
 #if defined(CONFIG_ESP32S3_SPIRAM_COMMON_HEAP) && !defined(MM_USER_HEAP_EXTRAM)
   start = (void *)esp_spiram_allocable_vaddr_start();
-  end = (void *)(esp_spiram_allocable_vaddr_end() -
-                 esp_himem_reserved_area_size());
+
+  /* Top ESP32S3_PSRAM_STATIC_CARVE_SIZE bytes are kept out of the common
+   * heap (camera RX/shadow etc. via esp32s3_psram_static_alloc) so those
+   * buffers stop eating the internal DRAM that esp_wifi requires. */
+
+  end = (void *)esp32s3_psram_static_base();
   size  = (size_t)(end - start);
 #endif
 
