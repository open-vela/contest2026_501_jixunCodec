diff --git a/audioutils/alsa-lib/pcm_hw.c b/audioutils/alsa-lib/pcm_hw.c
--- a/audioutils/alsa-lib/pcm_hw.c
+++ b/audioutils/alsa-lib/pcm_hw.c
@@ -761,7 +761,33 @@
   ret = ioctl(hw->fd, AUDIOIOC_GETLATENCY, delayp);
   if (ret < 0)
     {
-      return -errno;
+      int error = errno;
+      long queued;
+
+      if (error != ENOTTY && error != ENOSYS && error != ENOTSUP)
+        {
+          return -error;
+        }
+
+      /* Some raw codec lower halves have no GETLATENCY ioctl. Use the
+       * completed-period counters instead. This measures software queue
+       * depth; it cannot locate the current DMA position within a period.
+       * Capture's partial period has already been read, whereas playback's
+       * partial period is still waiting to be submitted. */
+
+      queued = (long)(pcm->appl - hw->status->tail);
+      if (pcm->stream == SND_PCM_STREAM_CAPTURE)
+        {
+          avail = ((long)pcm->periods - queued) * pcm->period_size -
+                  hw->offset;
+        }
+      else
+        {
+          avail = queued * pcm->period_size + hw->offset;
+        }
+
+      *delayp = avail > 0 ? avail : 0;
+      return 0;
     }
 
   avail = (pcm->appl - hw->status->head) * pcm->period_size;
