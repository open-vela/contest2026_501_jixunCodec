diff --git a/hal/hal_uv_client_usb.c b/hal/hal_uv_client_usb.c
--- a/hal/hal_uv_client_usb.c
+++ b/hal/hal_uv_client_usb.c
@@ -125,6 +125,20 @@
  * Public Functions
  ****************************************************************************/
 
+/* Gadget endpoints are published asynchronously when the host configures
+ * USB.  Keep the daemon alive until the first host connection is ready.
+ */
+static int usb_uv_open_endpoint(const char *path, int flags) {
+    for (;;) {
+        int fd = open(path, flags);
+        if (fd >= 0 || (errno != ENOENT && errno != ENODEV &&
+                        errno != ENOTCONN && errno != EAGAIN)) {
+            return fd;
+        }
+        usleep(100000);
+    }
+}
+
 int adb_uv_usb_setup(adb_context_uv_t *adbd, const char *path) {
     char devname[32];
     adb_client_usb_t *client;
