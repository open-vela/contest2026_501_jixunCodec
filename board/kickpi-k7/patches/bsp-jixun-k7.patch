diff --git a/boards/rk3576/kickpi-k7/src/jixun_focaltech_touch.c b/boards/rk3576/kickpi-k7/src/jixun_focaltech_touch.c
new file mode 100644
--- /dev/null
+++ b/boards/rk3576/kickpi-k7/src/jixun_focaltech_touch.c
@@ -0,0 +1,70 @@
+/* Actual Jixun K7 boards: FocalTech on I2C0 M1, address 0x38.
+ * Wiring and coordinate range come from the original boards' live DTs.
+ * Do not download the reference BSP's GT911 configuration into this module.
+ */
+#include <nuttx/config.h>
+#include <nuttx/arch.h>
+#include <nuttx/irq.h>
+#include <nuttx/i2c/i2c_master.h>
+#include <nuttx/input/ft5x06.h>
+#include <errno.h>
+#include <syslog.h>
+#include "rk3576_gpio.h"
+#include "rk3576_i2c.h"
+
+static struct gpio_dev_s *g_scl, *g_sda, *g_rst, *g_int;
+static xcpt_t g_isr;
+static void *g_arg;
+static int touch_irq(struct gpio_dev_s *dev, uint8_t pin)
+{
+  if (g_isr) return g_isr(0, NULL, g_arg);
+  return 0;
+}
+static int touch_attach(const struct ft5x06_config_s *cfg, xcpt_t isr, void *arg)
+{
+  g_isr = isr; g_arg = arg;
+  rk3576_gpio_set_int_type(g_int, RK3576_GPIO_INT_EDGE);
+  rk3576_gpio_set_int_pol(g_int, RK3576_GPIO_INT_LOW_FALLING);
+  return rk3576_gpio_irq_attach(g_int, isr ? touch_irq : NULL);
+}
+static void touch_enable(const struct ft5x06_config_s *cfg, bool on)
+{
+  if (on) rk3576_gpio_irq_enable(g_int);
+  else rk3576_gpio_irq_disable(g_int);
+}
+static void touch_clear(const struct ft5x06_config_s *cfg) { /* GPIO ISR ACKs. */ }
+static void touch_reset(const struct ft5x06_config_s *cfg, bool high)
+{
+  rk3576_gpio_write_bit(g_rst, high);
+}
+static void touch_wakeup(const struct ft5x06_config_s *cfg) { /* Always active. */ }
+static struct ft5x06_config_s g_cfg = {
+  .address=0x38, .frequency=400000,
+  .attach=touch_attach, .enable=touch_enable, .clear=touch_clear,
+  .nreset=touch_reset, .wakeup=touch_wakeup
+};
+int jixun_focaltech_initialize(void)
+{
+  int ret;
+  struct i2c_master_s *bus;
+  uint8_t reg=0xa3, chip=0;
+  if ((ret=rk3576_gpio_get(GPIO_PORT0|GPIO_PIN_C1,&g_scl))<0) return ret;
+  if ((ret=rk3576_gpio_get(GPIO_PORT0|GPIO_PIN_C2,&g_sda))<0) return ret;
+  rk3576_gpio_set_af(g_scl,9); rk3576_gpio_set_af(g_sda,9);
+  if ((ret=rk3576_gpio_get(GPIO_PORT0|GPIO_PIN_D0,&g_rst))<0) return ret;
+  if ((ret=rk3576_gpio_get(GPIO_PORT0|GPIO_PIN_C5,&g_int))<0) return ret;
+  rk3576_gpio_set_af(g_rst,0); rk3576_gpio_set_af(g_int,0);
+  rk3576_gpio_set_mode(g_rst,RK3576_GPIO_OUTPUT);
+  rk3576_gpio_set_mode(g_int,RK3576_GPIO_INPUT);
+  rk3576_gpio_set_pull(g_int,RK3576_GPIO_PULLUP);
+  touch_reset(&g_cfg,false); up_mdelay(20);
+  touch_reset(&g_cfg,true); up_mdelay(200);
+  bus=rk3576_i2c_initialize(0);
+  if (!bus) return -ENODEV;
+  struct i2c_config_s cfg={.frequency=400000,.address=0x38,.addrlen=7};
+  ret=i2c_writeread(bus,&cfg,&reg,1,&chip,1);
+  if (ret<0) {syslog(LOG_ERR,"FocalTech chip probe failed: %d\n",ret);return ret;}
+  ret=ft5x06_register(bus,&g_cfg,0);
+  syslog(LOG_INFO,"FocalTech chip=0x%02x register=%d /dev/input0 native=720x1280\n",chip,ret);
+  return ret;
+}
diff --git a/chips/rk3576/include/cpu_topology.h b/chips/rk3576/include/cpu_topology.h
new file mode 100644
--- /dev/null
+++ b/chips/rk3576/include/cpu_topology.h
@@ -0,0 +1,5 @@
+#ifndef RK3576_CPU_TOPOLOGY_H
+#define RK3576_CPU_TOPOLOGY_H
+/* A53: MPIDR 0..3; A72: MPIDR 0x100..0x103. */
+#define MPID_TO_CORE(mpid) (((mpid) & 3) | (((mpid) >> 6) & 4))
+#endif
