+/* PSRAM top carve: 128KB reserved out of the common heap so static-ish
+ * buffers (camera RX/shadow, later voice) can live in PSRAM deterministically
+ * and stop occupying the scarce internal DRAM that esp_wifi requires.
+ * Kept out of the umm region (see xtensa_add_region in
+ * esp32s3_allocateheap.c).  64B aligned bump allocator, no free. */
+
+/* 2026-09-13 第十二轮：极讯 codec 只用语音+WiFi，相机不用。
+ * 原本在 PSRAM 顶部划走 2MB 给相机 RX/shadow（唯一使用者是
+ * esp32s3_cam_dvp.c），并回公共堆后：堆 6.36MB -> 8.36MB。
+ * 并行编近解码需 ~6.9MB，不并回就会 malloc 失败 -> 空指针写崩溃。
+ * 需要相机时把下面改回 0x200000 即可（或 -DESP32S3_PSRAM_STATIC_CARVE_SIZE=0x200000）。 */
+#ifndef ESP32S3_PSRAM_STATIC_CARVE_SIZE
+#  define ESP32S3_PSRAM_STATIC_CARVE_SIZE 0x0
+#endif
+
+uint32_t esp32s3_psram_static_base(void);
+void *esp32s3_psram_static_alloc(size_t size);
+
 #ifdef __cplusplus
 }
 #endif
