+  uintptr_t base;
+  uintptr_t start;
+
+  if (size == 0)
+    {
+      return NULL;
+    }
+
+  size = (size + 63) & ~(size_t)63;
+
+  base = esp32s3_psram_static_base();
+  if (base == 0 || base < esp_spiram_allocable_vaddr_start())
+    {
+      return NULL;
+    }
+
+  if (s_offset + size > ESP32S3_PSRAM_STATIC_CARVE_SIZE)
+    {
+      return NULL;
+    }
+
+  start = base + s_offset;
+  s_offset += size;
+
+  memset((void *)start, 0, size);
+
+  return (void *)start;
+}
+
 #endif
